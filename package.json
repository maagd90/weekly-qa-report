{
  "name": "qa-dashboard",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/batch"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "build": "npm run build --workspace=apps/batch && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "generate": "npm run generate --workspace=apps/batch",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
