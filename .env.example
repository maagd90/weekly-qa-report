# ---------------------------------------------------------------------------
# QA Dashboard — Environment Variables
# Copy this file to .env and fill in the values.
# ---------------------------------------------------------------------------

# API server port (default 3001)
PORT=3001

# Optional: override folder paths (defaults are repo-root input/, output/, config/)
# INPUT_DIR=./input
# OUTPUT_DIR=./output
# CONFIG_DIR=./config
# PROJECT_ROOT=.

# ---------------------------------------------------------------------------
# AI Report (required for Generate Report)
# ---------------------------------------------------------------------------

# Claude API key — used by batch job when generating reports
ANTHROPIC_API_KEY=sk-ant-api03-...
