# ---------------------------------------------------------------------------
# QA Dashboard — Environment Variables
# Copy this file to .env and fill in the values.
# ---------------------------------------------------------------------------

# Optional: path to an Excel file to auto-import on startup.
# Leave blank to use the Upload tab in the UI instead.
# EXCEL_SOURCE_PATH=/data/team-metrics.xlsx

# API server port (default 3001)
PORT=3001

# SQLite database path (default: apps/api/data/qa_dashboard.db)
# DB_PATH=/data/qa_dashboard.db

# ---------------------------------------------------------------------------
# AI Features (Claude integration)
# ---------------------------------------------------------------------------

# 32-character random string used to AES-256 encrypt the Claude API key
# stored in the database. Change this before deploying.
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=change-me-to-a-32-char-secret!!!

# The Claude API key is stored via the Settings UI (never in .env).
# ANTHROPIC_API_KEY is only needed here if you want to override the DB key
# for development/testing.
# ANTHROPIC_API_KEY=sk-ant-api03-...
