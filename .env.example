# ---------------------------------------------------------------------------
# QA Dashboard — Environment Variables
# Copy this file to .env and fill in the values.
# ---------------------------------------------------------------------------

# API server port (default 3001)
PORT=3001

# Optional: override folder paths (defaults are repo-root input/, output/, config/)
# INPUT_DIR=./input
# OUTPUT_DIR=./output
# CONFIG_DIR=./config
# PROJECT_ROOT=.

# Claude API key — optional; dashboard works without it, AI report requires it
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional — override the report model (else taken from config/report.json)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Corporate proxy (office/VPN) — opt-in via config/report.json only:
#   "proxy": { "enabled": true, "url": "http://proxy.corp.example.com:8080" }
# URL can also come from ANTHROPIC_PROXY_URL or HTTPS_PROXY when proxy.enabled is true.
# With auth: http://user:pass@proxy.corp.example.com:8080
# ANTHROPIC_PROXY_URL=http://proxy.corp.example.com:8080
# TLS-intercepting proxy (SELF_SIGNED_CERT_IN_CHAIN)? point Node at the corporate CA:
# NODE_EXTRA_CA_CERTS=C:\path\to\corporate-ca.pem

# ---------------------------------------------------------------------------
# PDF export (local dev only — Docker sets these automatically)
# ---------------------------------------------------------------------------
# Path to a real Chrome/Chromium/Edge binary on your machine:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# URL of the running web app's print route (Vite dev serves on :3000):
# PDF_PRINT_URL=http://localhost:3000/print/report

# ---------------------------------------------------------------------------
# JIRA / QMetry (optional — for live API fetch via config/integrations.json)
# ---------------------------------------------------------------------------

JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token

# Optional — pre-encoded Basic auth (Java QmetryPublisher pattern: "Basic base64...")
# QMETRY_BASIC_AUTH=Basic xxxxx
