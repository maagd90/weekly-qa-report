# ---------------------------------------------------------------------------
# Node / API
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_PORT=3000
PROJECT_ROOT=.
INPUT_DIR=./input
OUTPUT_DIR=./output
CONFIG_DIR=./config

# ---------------------------------------------------------------------------
# LLM Provider Defaults
# Provider options: anthropic | openai | gemini | openai-compatible
# Users choose the active provider/model from Settings.
# Provider credentials stay in this local .env and are never committed.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001

# Add one or more provider credentials in your local .env only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CUSTOM_LLM_API_KEY=

# Optional provider-specific model/base URL overrides.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_MODEL=gpt-5.2-mini
# GEMINI_MODEL=gemini-3.5-flash
# CUSTOM_LLM_MODEL=custom-model
# CUSTOM_LLM_BASE_URL=https://provider.example.com/v1

# Corporate proxy (office/VPN) — used by live integrations and LLM calls where supported.
# ANTHROPIC_PROXY_URL=http://proxy.corp.example.com:8080
# HTTPS_PROXY=http://proxy.corp.example.com:8080
# HTTP_PROXY=http://proxy.corp.example.com:8080

# Local Docker compatibility for office/on-prem JIRA/QMetry certificates.
# Keep true if Docker shows SELF_SIGNED_CERT_IN_CHAIN for internal APIs.
# For stricter validation, set both values false and mount your company root CA, then set:
# NODE_EXTRA_CA_CERTS=/data/config/certs/company-root-ca.pem
INTEGRATION_ALLOW_SELF_SIGNED_CERTS=true
JIRA_ALLOW_SELF_SIGNED=true
NODE_EXTRA_CA_CERTS=

# ---------------------------------------------------------------------------
# Live JIRA / QMetry integration examples
# ---------------------------------------------------------------------------
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_CLOUD_EMAIL=
JIRA_CLOUD_SECRET=
JIRA_ONPREM_SECRET=

# Optional for on-prem JIRA behind SSO/session redirect.
# Option 1: paste the full cookie string without the "Cookie:" prefix.
# Example format: JSESSIONID=...; atlassian.xsrf.token=...
JIRA_SESSION_HEADER=

# Option 2: provide both cookie values separately. The backend combines them as:
# Cookie: JSESSIONID=<value>; atlassian.xsrf.token=<value>
JIRA_SESSION_ID=
JIRA_XSRF_TOKEN=

QMETRY_BASIC_AUTH=
