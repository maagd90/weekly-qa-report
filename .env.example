# ---------------------------------------------------------------------------
# QA Dashboard — Environment Variables
# Copy this file to .env and fill in the values locally.
# ---------------------------------------------------------------------------

# API server port (default 3001)
PORT=3001

# Optional: override folder paths (defaults are repo-root input/, output/, config/)
# INPUT_DIR=./input
# OUTPUT_DIR=./output
# CONFIG_DIR=./config
# PROJECT_ROOT=.

# ---------------------------------------------------------------------------
# LLM Provider Defaults
# Provider options: anthropic | openai | gemini | openai-compatible
# The AI Report page also allows provider/model selection from the UI.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001

# Add one or more provider credentials in your local .env only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CUSTOM_LLM_API_KEY=

# Optional provider-specific model/base URL overrides.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_MODEL=gpt-5.2-mini
# GEMINI_MODEL=gemini-3.5-flash
# CUSTOM_LLM_MODEL=custom-model
# CUSTOM_LLM_BASE_URL=https://provider.example.com/v1

# Corporate proxy (office/VPN) — currently used by Anthropic path.
# ANTHROPIC_PROXY_URL=http://proxy.corp.example.com:8080
# HTTPS_PROXY=http://proxy.corp.example.com:8080
# NODE_EXTRA_CA_CERTS=C:\path\to\corporate-ca.pem

# ---------------------------------------------------------------------------
# PDF export (local dev only — Docker sets these automatically)
# ---------------------------------------------------------------------------
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PDF_PRINT_URL=http://localhost:3000/print/report

# ---------------------------------------------------------------------------
# JIRA / QMetry fallback config (optional — config/integrations.json can override)
# ---------------------------------------------------------------------------
JIRA_EMAIL=
JIRA_API_TOKEN=

# Separate credentials for config/integrations.json jiraProfiles examples.
JIRA_CLOUD_EMAIL=
JIRA_CLOUD_SECRET=
JIRA_ONPREM_SECRET=

# Optional pre-encoded Basic auth for QMetry.
# QMETRY_BASIC_AUTH=
